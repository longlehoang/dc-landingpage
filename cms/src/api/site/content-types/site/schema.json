{
  "kind": "collectionType",
  "collectionName": "sites",
  "info": {
    "singularName": "site",
    "pluralName": "sites",
    "displayName": "Site",
    "description": "Header and footer of one sub-site (corporate, individual, institution, regulatory)"
  },
  "options": {
    "draftAndPublish": true
  },
  "pluginOptions": {
    "i18n": {
      "localized": true
    }
  },
  "attributes": {
    "key": {
      "type": "enumeration",
      "enum": [
        "corporate",
        "individual",
        "institution",
        "regulatory"
      ],
      "required": true,
      "pluginOptions": {
        "i18n": {
          "localized": false
        }
      }
    },
    "label": {
      "type": "string",
      "pluginOptions": {
        "i18n": {
          "localized": true
        }
      }
    },
    "logo": {
      "type": "media",
      "multiple": false,
      "allowedTypes": [
        "images"
      ],
      "pluginOptions": {
        "i18n": {
          "localized": false
        }
      }
    },
    "footerLogo": {
      "type": "media",
      "multiple": false,
      "allowedTypes": [
        "images"
      ],
      "pluginOptions": {
        "i18n": {
          "localized": false
        }
      }
    },
    "nav": {
      "type": "component",
      "repeatable": true,
      "component": "shared.nav-item",
      "pluginOptions": {
        "i18n": {
          "localized": true
        }
      }
    },
    "headerCta": {
      "type": "component",
      "repeatable": false,
      "component": "shared.link",
      "pluginOptions": {
        "i18n": {
          "localized": true
        }
      }
    },
    "footerColumns": {
      "type": "component",
      "repeatable": true,
      "component": "shared.link-group",
      "pluginOptions": {
        "i18n": {
          "localized": true
        }
      }
    },
    "socialLinks": {
      "type": "component",
      "repeatable": true,
      "component": "shared.social-link",
      "pluginOptions": {
        "i18n": {
          "localized": true
        }
      }
    },
    "appTitle": {
      "type": "string",
      "pluginOptions": {
        "i18n": {
          "localized": true
        }
      }
    },
    "appStoreUrl": {
      "type": "string",
      "pluginOptions": {
        "i18n": {
          "localized": false
        }
      }
    },
    "playStoreUrl": {
      "type": "string",
      "pluginOptions": {
        "i18n": {
          "localized": false
        }
      }
    },
    "appStoreBadge": {
      "type": "media",
      "multiple": false,
      "allowedTypes": [
        "images"
      ],
      "pluginOptions": {
        "i18n": {
          "localized": false
        }
      }
    },
    "playStoreBadge": {
      "type": "media",
      "multiple": false,
      "allowedTypes": [
        "images"
      ],
      "pluginOptions": {
        "i18n": {
          "localized": false
        }
      }
    },
    "legalLinks": {
      "type": "component",
      "repeatable": true,
      "component": "shared.link",
      "pluginOptions": {
        "i18n": {
          "localized": true
        }
      }
    },
    "copyright": {
      "type": "string",
      "pluginOptions": {
        "i18n": {
          "localized": true
        }
      }
    },
    "zaloUrl": {
      "type": "string",
      "pluginOptions": {
        "i18n": {
          "localized": false
        }
      }
    },
    "appModal": {
      "type": "component",
      "repeatable": false,
      "component": "blocks.app-promo",
      "pluginOptions": {
        "i18n": {
          "localized": true
        }
      }
    }
  }
}
