# Strapi base URL (no trailing slash)
STRAPI_URL=http://localhost:1337
# Optional: only needed if you remove public read access in Strapi
STRAPI_READ_TOKEN=
# Write-only token for contact submissions (cms `npm run seed` writes it to .env.local)
STRAPI_WRITE_TOKEN=
# Shared secret for the Strapi -> Next.js revalidation webhook
REVALIDATE_SECRET=
